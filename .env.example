# Server
PORT=3000

# Target website base URL (trailing slash is optional)
BASE_URL=https://javhd.today

# CORS — use * to allow all origins, or a specific origin like http://localhost:5173
CORS_ORIGIN=*

# Request timeout in milliseconds (default 20 s)
REQUEST_TIMEOUT=20000

# Maximum retries on network failure
MAX_RETRIES=2

# Node TLS — set to "0" only when the target has a self-signed cert (like javhd.today)
NODE_TLS_REJECT_UNAUTHORIZED=0
